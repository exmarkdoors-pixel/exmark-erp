# =================================================================
# EXMARK ERP — Production Environment Configuration Template
# Kerala FRP & WPC Door Manufacturing Business Management System
# =================================================================
#
# SECURITY NOTICE:
# - Copy this file to .env.production on the production host.
# - NEVER commit the real .env.production file to version control.
# - Replace all placeholders with secure, generated credentials.
# =================================================================

# 1. Central PostgreSQL Database Connection (Production Authoritative Datastore)
# Use a pooled connection for runtime queries and direct URL for Prisma migrations.
# Example for Neon/Supabase/DigitalOcean Managed DB:
DATABASE_URL="postgresql://exmark_prod_admin:REPLACE_WITH_STRONG_PASSWORD@db.exmarkdoors.com:6543/exmark_erp_prod?sslmode=require&pgbouncer=true&connection_limit=25"
DIRECT_URL="postgresql://exmark_prod_admin:REPLACE_WITH_STRONG_PASSWORD@db.exmarkdoors.com:5432/exmark_erp_prod?sslmode=require"

# 2. Authentication & Server-Side Session Security
# Generate using: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_GENERATED_32_CHAR_RANDOM_SECRET_KEY_FOR_PROD"
NEXTAUTH_URL="https://erp.exmarkdoors.com"
NEXT_PUBLIC_APP_URL="https://erp.exmarkdoors.com"

# 3. Authoritative Datastore Strictness (Split-Brain Prevention)
# In production, this MUST be set to true.
# Prevents silent fallback writes to local files if database connectivity is interrupted.
ENABLE_STRICT_POSTGRES="true"
DATABASE_FALLBACK_PERMITTED="false"
OUTBOX_AUTO_RECONCILE_INTERVAL_MS="10000"

# 4. Product Category Defaults (FRP Primary, WPC Optional)
# EXMARK primary line is FRP Doors. WPC remains disabled by default until admin activation.
DEFAULT_CATEGORY_FRP="true"
DEFAULT_CATEGORY_WPC="false"

# 5. External Production Integrations (Configure when live contracts are signed)
# Razorpay / HDFC Payment Gateway
ENABLE_REAL_PAYMENT_GATEWAY="false"
PAYMENT_GATEWAY_KEY_ID="rzp_live_placeholder"
PAYMENT_GATEWAY_KEY_SECRET="rzp_secret_placeholder"

# WhatsApp Cloud API (Meta Graph API / Gupshup / Aisensy)
ENABLE_REAL_SMS_WHATSAPP="false"
WHATSAPP_API_TOKEN="whatsapp_bearer_token_placeholder"
WHATSAPP_PHONE_NUMBER_ID="phone_number_id_placeholder"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="webhook_verify_token_placeholder"

# GST E-Way Bill / E-Invoice System (NIC / Cleartax API)
ENABLE_EXTERNAL_EWAY_API="false"
EWAY_API_CLIENT_ID="eway_client_id_placeholder"
EWAY_API_CLIENT_SECRET="eway_client_secret_placeholder"

# 6. Corporate Multi-Device Access & CORS
ALLOWED_ORIGINS="https://erp.exmarkdoors.com,https://m.erp.exmarkdoors.com"
SESSION_EXPIRY_SECONDS="86400"
