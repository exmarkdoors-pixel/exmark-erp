{
  "name": "exmark-erp",
  "version": "1.2.2",
  "private": true,
  "description": "EXMARK ERP — Enterprise FRP Architectural Doors Manufacturing Platform",
  "author": "EXMARK DOORS PRIVATE LIMITED",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 4000",
    "build": "node scripts/deploy-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "electron electron/main.js",
    "desktop:prepare": "node scripts/prepare-electron-standalone.mjs",
    "desktop:build": "node scripts/prepare-electron-standalone.mjs && electron-builder && node scripts/publish-release-exes.mjs",
    "desktop:publish": "node scripts/publish-release-exes.mjs --clean-old",
    "mobile:sync": "cap sync android",
    "mobile:build": "tsx scripts/build-apk.ts",
    "mobile:ios:sync": "cap sync ios",
    "mobile:ios:build": "tsx scripts/package-ipa.ts",
    "mobile:ios:package": "tsx scripts/package-ipa.ts",
    "mobile:ios:open": "cap open ios",
    "build:binaries": "npm run desktop:build && npm run mobile:build && npm run mobile:ios:build",
    "test:master": "tsx scripts/test-master.ts",
    "test:phase9": "tsx scripts/test-phase9-security.ts",
    "test:workflow": "tsx scripts/test-workflow-e2e.ts",
    "erp:full-audit": "tsx scripts/master-erp-full-suite.ts --audit",
    "erp:simulate": "tsx scripts/master-erp-full-suite.ts --simulate",
    "erp:health": "tsx scripts/master-erp-full-suite.ts --health",
    "erp:reset-zero": "tsx scripts/reset-all-modules-zero.ts",
    "erp:factory-clean": "tsx scripts/reset-all-modules-zero.ts",
    "erp:migrate": "tsx scripts/safe-update-migrate.ts",
    "start:factory": "node scripts/start-local-server.mjs --port 4000 --host 0.0.0.0 --watch",
    "start:factory:open": "node scripts/start-local-server.mjs --port 4000 --host 0.0.0.0 --open --watch",
    "reset-admin-password": "tsx scripts/reset-super-admin-password.ts",
    "backup": "tsx scripts/backup-agent.ts",
    "db:offline-setup": "tsx scripts/setup-offline-sql-server.ts",
    "db:sql-dump": "tsx scripts/backup-offline-sql.ts"
  },
  "dependencies": {
    "@capacitor/geolocation": "^8.2.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
