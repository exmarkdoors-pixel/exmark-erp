# =================================================================
# EXMARK ERP - Environment Configuration Template
# Kerala FRP & WPC Door Manufacturing Business Management System
# =================================================================

# 1. PostgreSQL Database Connection (Stage 4 Foundation)
# Replace with your PostgreSQL credentials (e.g. local PostgreSQL, Docker, or Cloud instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exmark_erp?schema=public"

# 2. Authentication & Server-Side Session Security
# Generate a secure 32+ character key using: openssl rand -base64 32
AUTH_SECRET="exmark_erp_super_secure_session_secret_key_2026_palakkad_kerala"

# 3. Application URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Optional Service Flags (Strictly Disabled for Stage 4 Compliance)
ENABLE_REAL_PAYMENT_GATEWAY="false"
ENABLE_REAL_SMS_WHATSAPP="false"
ENABLE_EXTERNAL_EWAY_API="false"
